package com.kamal.jarvis.v2.core;

import java.util.ArrayList;
import java.util.Collections;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.concurrent.CopyOnWriteArrayList;

/**
 * JARVIS V2 Runtime
 *
 * القلب التنفيذي للنظام.
 *
 * المسؤوليات:
 * 1. إدارة دورة حياة JARVIS.
 * 2. تسجيل الأدوات وإزالتها.
 * 3. التحقق من توفر الأدوات.
 * 4. تنفيذ الأدوات بطريقة موحدة.
 * 5. تسجيل أحداث التنفيذ.
 * 6. توفير سجل أحداث محدود.
 * 7. منع تسجيل Tool بنفس المعرف بشكل غير متوقع.
 *
 * Runtime لا:
 * - يبني قدرات.
 * - يغير OwnerSecurityBoundary.
 * - يمنح Android permissions.
 * - يعدل كود المشروع.
 *
 * هذه المسؤوليات تبقى في المكونات المتخصصة.
 */
public final class JarvisRuntime {

    private static final int MAX_EVENT_HISTORY = 500;

    private final Map<String, ToolContract> tools =
            new LinkedHashMap<>();

    private final List<JarvisEvent> eventHistory =
            new CopyOnWriteArrayList<>();

    private final List<RuntimeEventListener> listeners =
            new CopyOnWriteArrayList<>();

    private volatile RuntimeState state =
            RuntimeState.CREATED;

    private volatile long startedAt = 0L;

    /**
     * يبدأ Runtime.
     */
    public synchronized JarvisResult<Void> start() {

        if (state == RuntimeState.RUNNING) {
            return JarvisResult.success(
                    null,
                    "JARVIS Runtime is already running."
            );
        }

        if (state == RuntimeState.STOPPED) {
            return failure(
                    JarvisError.Type.EXECUTION_FAILED,
                    "A stopped Runtime cannot be started again."
            );
        }

        startedAt = System.currentTimeMillis();
        state = RuntimeState.RUNNING;

        publishEvent(
                JarvisEvent.Type.SYSTEM,
                "JarvisRuntime",
                "JARVIS Runtime started."
        );

        return JarvisResult.success(
                null,
                "JARVIS Runtime started successfully."
        );
    }

    /**
     * يوقف Runtime.
     *
     * الأدوات نفسها لا يتم حذفها.
     */
    public synchronized JarvisResult<Void> stop() {

        if (state == RuntimeState.STOPPED) {
            return JarvisResult.success(
                    null,
                    "JARVIS Runtime is already stopped."
            );
        }

        state = RuntimeState.STOPPED;

        publishEvent(
                JarvisEvent.Type.SYSTEM,
                "JarvisRuntime",
                "JARVIS Runtime stopped."
        );

        return JarvisResult.success(
                null,
                "JARVIS Runtime stopped."
        );
    }

    /**
     * يعيد Runtime إلى حالة جاهزة بدون حذف الأدوات.
     */
    public synchronized JarvisResult<Void> reset() {

        tools.clear();
        eventHistory.clear();

        startedAt = 0L;
        state = RuntimeState.CREATED;

        publishEvent(
                JarvisEvent.Type.SYSTEM,
                "JarvisRuntime",
                "JARVIS Runtime reset."
        );

        return JarvisResult.success(
                null,
                "JARVIS Runtime reset successfully."
        );
    }

    /**
     * يسجل Tool جديدة.
     *
     * إذا كان نفس ID موجوداً يتم رفض التسجيل.
     * الاستبدال يجب أن يكون صريحاً عبر replaceTool().
     */
    public synchronized JarvisResult<Void> registerTool(
            ToolContract tool
    ) {

        if (tool == null) {
            return failure(
                    JarvisError.Type.INVALID_REQUEST,
                    "Tool cannot be null."
            );
        }

        String id = normalizeId(tool.getId());

        if (id == null) {
            return failure(
                    JarvisError.Type.VALIDATION_FAILED,
                    "Tool ID cannot be empty."
            );
        }

        if (tools.containsKey(id)) {
            return failure(
                    JarvisError.Type.VALIDATION_FAILED,
                    "Tool already exists: " + id
            );
        }

        tools.put(id, tool);

        publishEvent(
                JarvisEvent.Type.TOOL,
                "JarvisRuntime",
                "Tool registered: " + id
        );

        return JarvisResult.success(
                null,
                "Tool registered successfully."
        );
    }

    /**
     * يستبدل Tool موجودة بشكل صريح.
     */
    public synchronized JarvisResult<Void> replaceTool(
            ToolContract tool
    ) {

        if (tool == null) {
            return failure(
                    JarvisError.Type.INVALID_REQUEST,
                    "Tool cannot be null."
            );
        }

        String id = normalizeId(tool.getId());

        if (id == null) {
            return failure(
                    JarvisError.Type.VALIDATION_FAILED,
                    "Tool ID cannot be empty."
            );
        }

        boolean existed = tools.containsKey(id);

        tools.put(id, tool);

        publishEvent(
                JarvisEvent.Type.TOOL,
                "JarvisRuntime",
                existed
                        ? "Tool replaced: " + id
                        : "Tool registered through replacement: " + id
        );

        return JarvisResult.success(
                null,
                existed
                        ? "Tool replaced successfully."
                        : "Tool registered successfully."
        );
    }

    /**
     * يزيل Tool.
     */
    public synchronized JarvisResult<Void> unregisterTool(
            String toolId
    ) {

        String id = normalizeId(toolId);

        if (id == null) {
            return failure(
                    JarvisError.Type.INVALID_REQUEST,
                    "Tool ID cannot be empty."
            );
        }

        if (!tools.containsKey(id)) {
            return failure(
                    JarvisError.Type.NOT_FOUND,
                    "Tool not found: " + id
            );
        }

        tools.remove(id);

        publishEvent(
                JarvisEvent.Type.TOOL,
                "JarvisRuntime",
                "Tool unregistered: " + id
        );

        return JarvisResult.success(
                null,
                "Tool unregistered successfully."
        );
    }

    /**
     * يرجع Tool حسب ID.
     */
    public JarvisResult<ToolContract> getTool(
            String toolId
    ) {

        String id = normalizeId(toolId);

        if (id == null) {
            return failure(
                    JarvisError.Type.INVALID_REQUEST,
                    "Tool ID cannot be empty."
            );
        }

        ToolContract tool = tools.get(id);

        if (tool == null) {
            return failure(
                    JarvisError.Type.NOT_FOUND,
                    "Tool not found: " + id
            );
        }

        return JarvisResult.success(
                tool,
                "Tool found."
        );
    }

    /**
     * يتحقق من وجود Tool.
     */
    public boolean containsTool(
            String toolId
    ) {

        String id = normalizeId(toolId);

        return id != null &&
                tools.containsKey(id);
    }

    /**
     * يتحقق من توفر Tool.
     */
    public boolean isToolAvailable(
            String toolId
    ) {

        String id = normalizeId(toolId);

        if (id == null) {
            return false;
        }

        ToolContract tool = tools.get(id);

        return tool != null &&
                tool.isAvailable();
    }

    /**
     * ينفذ Tool.
     */
    public JarvisResult<ToolContract.ToolOutput> execute(
            String toolId,
            ToolContract.ToolInput input
    ) {

        if (!isRunning()) {
            return failure(
                    JarvisError.Type.EXECUTION_FAILED,
                    "JARVIS Runtime is not running."
            );
        }

        String id = normalizeId(toolId);

        if (id == null) {
            return failure(
                    JarvisError.Type.INVALID_REQUEST,
                    "Tool ID cannot be empty."
            );
        }

        ToolContract tool = tools.get(id);

        if (tool == null) {

            publishEvent(
                    JarvisEvent.Type.TOOL,
                    "JarvisRuntime",
                    "Execution failed: tool not found: " + id
            );

            return failure(
                    JarvisError.Type.NOT_FOUND,
                    "Tool not found: " + id
            );
        }

        if (!tool.isAvailable()) {

            publishEvent(
                    JarvisEvent.Type.TOOL,
                    "JarvisRuntime",
                    "Execution blocked because tool is unavailable: "
                            + id
            );

            return failure(
                    JarvisError.Type.TOOL_UNAVAILABLE,
                    "Tool is unavailable: " + id
            );
        }

        if (input == null) {
            return failure(
                    JarvisError.Type.INVALID_REQUEST,
                    "Tool input cannot be null."
            );
        }

        publishEvent(
                JarvisEvent.Type.COMMAND,
                "JarvisRuntime",
                "Executing tool: " + id
        );

        long started = System.currentTimeMillis();

        try {

            ToolContract.ToolOutput output =
                    tool.execute(input);

            long duration =
                    System.currentTimeMillis() - started;

            if (output == null) {

                publishEvent(
                        JarvisEvent.Type.TOOL,
                        "JarvisRuntime",
                        "Tool returned null output: " + id
                );

                return failure(
                        JarvisError.Type.EXECUTION_FAILED,
                        "Tool returned null output: " + id
                );
            }

            publishEvent(
                    JarvisEvent.Type.TOOL,
                    "JarvisRuntime",
                    "Tool executed successfully: "
                            + id
                            + " in "
                            + duration
                            + " ms"
            );

            return JarvisResult
                    .success(
                            output,
                            "Tool executed successfully."
                    )
                    .withMetadata(
                            "toolId",
                            id
                    )
                    .withMetadata(
                            "durationMs",
                            duration
                    );

        } catch (Exception exception) {

            long duration =
                    System.currentTimeMillis() - started;

            publishEvent(
                    JarvisEvent.Type.TOOL,
                    "JarvisRuntime",
                    "Tool execution failed: "
                            + id
                            + " after "
                            + duration
                            + " ms"
            );

            return JarvisResult.failure(
                    JarvisError.fromException(
                            JarvisError.Type.EXECUTION_FAILED,
                            "Tool execution failed: " + id,
                            "JarvisRuntime",
                            exception
                    )
            );
        }
    }

    /**
     * يرجع جميع الأدوات.
     */
    public synchronized List<ToolContract> getTools() {

        return Collections.unmodifiableList(
                new ArrayList<>(
                        tools.values()
                )
        );
    }

    /**
     * يرجع IDs ديال الأدوات.
     */
    public synchronized List<String> getToolIds() {

        return Collections.unmodifiableList(
                new ArrayList<>(
                        tools.keySet()
                )
        );
    }

    /**
     * عدد الأدوات.
     */
    public int getToolCount() {
        return tools.size();
    }

    /**
     * يضيف Listener للأحداث.
     */
    public void addEventListener(
            RuntimeEventListener listener
    ) {

        if (listener == null) {
            return;
        }

        if (!listeners.contains(listener)) {
            listeners.add(listener);
        }
    }

    /**
     * يحذف Listener.
     */
    public void removeEventListener(
            RuntimeEventListener listener
    ) {

        if (listener == null) {
            return;
        }

        listeners.remove(listener);
    }

    /**
     * يرجع سجل الأحداث.
     */
    public List<JarvisEvent> getEventHistory() {

        return Collections.unmodifiableList(
                new ArrayList<>(
                        eventHistory
                )
        );
    }

    /**
     * يمسح سجل الأحداث فقط.
     */
    public void clearEventHistory() {

        eventHistory.clear();

        publishEvent(
                JarvisEvent.Type.SYSTEM,
                "JarvisRuntime",
                "Runtime event history cleared."
        );
    }

    /**
     * حالة Runtime.
     */
    public RuntimeState getState() {
        return state;
    }

    public boolean isRunning() {
        return state == RuntimeState.RUNNING;
    }

    public boolean isCreated() {
        return state == RuntimeState.CREATED;
    }

    public boolean isStopped() {
        return state == RuntimeState.STOPPED;
    }

    /**
     * وقت تشغيل Runtime.
     */
    public long getStartedAt() {
        return startedAt;
    }

    /**
     * معلومات تشخيصية.
     */
    public RuntimeStatus getStatus() {

        return new RuntimeStatus(
                state,
                tools.size(),
                eventHistory.size(),
                startedAt
        );
    }

    /**
     * ينشر Event داخلي.
     */
    private void publishEvent(
            JarvisEvent.Type type,
            String source,
            String message
    ) {

        JarvisEvent event =
                new JarvisEvent(
                        type,
                        source,
                        message
                );

        eventHistory.add(event);

        while (eventHistory.size()
                > MAX_EVENT_HISTORY) {

            eventHistory.remove(0);
        }

        for (RuntimeEventListener listener :
                listeners) {

            try {
                listener.onEvent(event);
            } catch (Exception ignored) {
                /*
                 * Listener failure must never
                 * break the Runtime.
                 */
            }
        }
    }

    private String normalizeId(
            String value
    ) {

        if (value == null) {
            return null;
        }

        String normalized =
                value.trim();

        if (normalized.isEmpty()) {
            return null;
        }

        return normalized;
    }

    private <T> JarvisResult<T> failure(
            JarvisError.Type type,
            String message
    ) {

        return JarvisResult.failure(
                JarvisError.of(
                        type,
                        message,
                        "JarvisRuntime"
                )
        );
    }

    /**
     * حالات Runtime.
     */
    public enum RuntimeState {

        CREATED,

        RUNNING,

        STOPPED
    }

    /**
     * Listener للأحداث.
     */
    public interface RuntimeEventListener {

        void onEvent(
                JarvisEvent event
        );
    }

    /**
     * حالة Runtime للتشخيص والمراقبة.
     */
    public static final class RuntimeStatus {

        private final RuntimeState state;
        private final int toolCount;
        private final int eventCount;
        private final long startedAt;

        private RuntimeStatus(
                RuntimeState state,
                int toolCount,
                int eventCount,
                long startedAt
        ) {
            this.state = state;
            this.toolCount = toolCount;
            this.eventCount = eventCount;
            this.startedAt = startedAt;
        }

        public RuntimeState getState() {
            return state;
        }

        public int getToolCount() {
            return toolCount;
        }

        public int getEventCount() {
            return eventCount;
        }

        public long getStartedAt() {
            return startedAt;
        }

        public boolean isRunning() {
            return state ==
                    RuntimeState.RUNNING;
        }

        @Override
        public String toString() {

            return "RuntimeStatus{" +
                    "state=" +
                    state +
                    ", toolCount=" +
                    toolCount +
                    ", eventCount=" +
                    eventCount +
                    ", startedAt=" +
                    startedAt +
                    '}';
        }
    }
}